<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MentorLink" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:navigationBarColor">@color/screen_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Widget.MentorLink.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="boxCornerRadiusTopStart">20dp</item>
        <item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item>
        <item name="boxCornerRadiusBottomEnd">20dp</item>
    </style>

    <style name="Widget.MentorLink.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Widget.MentorLink.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/white_80</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.MentorLink.ChoiceChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/role_pill_bg</item>
        <item name="chipStrokeColor">@color/brand_primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/brand_primary_dark</item>
    </style>
</resources>
